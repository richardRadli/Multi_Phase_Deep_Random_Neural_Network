        },
        "musk2": {
          "type": "array"
        },
        "optdigits": {
          "type": "array"
        },
        "page_blocks": {
          "type": "array"
        },
        "satimages": {
          "type": "array"
        },
        "segment": {
          "type": "array"
        },
        "shuttle": {
          "type": "array"
        },
        "spambase": {
          "type": "array"
        },
        "usps": {
          "type": "array"
        },
        "wall": {
          "type": "array"
        },
        "waveform": {
          "type": "array"
        }
      }
    },
    "rcond": {
      "type": "object",
      "description": "Number of equal neurons.",
      "properties": {
        "adult": {
          "type": "array"
        },
        "cifar10": {
          "type": "array"
        },
        "connect4": {
